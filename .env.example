# ============================================================================
# ANTIGRAVITY - KAGGLE 2x T4 GPU KÖPRÜSÜ ÖRNEK ORTAM DOSYASI (.env.example)
# Kullanım: Bu dosyayı `.env` adıyla kopyalayın ve kendi anahtarlarınızı girin:
#   cp .env.example .env
# ============================================================================

# 1. Kaggle Hesap ve Resmi API Bilgileri
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
KAGGLE_KERNEL_ID=kullanici_adi/antigravity-gpu-bridge

# 2. Antigravity <-> Kaggle GPU Tüneli İç Güvenlik ve Haberleşme Anahtarları
AG_BRIDGE_AUTH_TOKEN=
AG_BRIDGE_NTFY_TOPIC=

# 3. Otomatik Kapanma (Watchdog) Süresi (Saniye - Varsayılan: 1200 sn = 20 dk)
AG_IDLE_TIMEOUT_SEC=1200
